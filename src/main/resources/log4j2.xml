<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_DIR">${sys:log.dir:-${sys:user.dir}/.immich-uploader/logs}</Property>
    </Properties>

    <Appenders>
        <RollingFile name="File"
                     fileName="${LOG_DIR}/immich-uploader.log"
                     filePattern="${LOG_DIR}/immich-uploader-%d{yyyyMMdd-HHmmss}-%i.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %logger - %msg%n" charset="UTF-8"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
            <!-- nomax: 滚动文件索引持续递增，不自动删除旧日志 -->
            <DefaultRolloverStrategy fileIndex="nomax"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="File"/>
        </Root>
    </Loggers>
</Configuration>
